{
  "name": "cflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp fmt --check && vp lint && tsc --noEmit -p api && tsc --noEmit -p web",
    "check:fix": "vp fmt && vp lint --fix && tsc --noEmit -p api && tsc --noEmit -p web",
    "test": "vp test",
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "start": "vp build && bun --tsconfig-override=api/tsconfig.json api/src/node.ts"
  },
