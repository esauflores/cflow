# Port CFlow listens on: the web app and the API together, both with `vp dev`
# and when node.ts runs the API on its own.
PORT=5173

# Allow a read-only "Enter as guest" session from the login screen (true/1/yes).
ALLOW_GUEST=false

# Set when a reverse proxy sits in front: login and guest limits then use the
# client address the proxy appends to X-Forwarded-For. Leave off otherwise.
TRUST_PROXY=false

# SQLite database file, relative to the repo root. It runs in WAL mode: back up
# its folder (the -wal file holds recent writes).
DATABASE_PATH=data/cflow.db

# Zone that defines "today" for transaction dates.
APP_TIMEZONE=UTC
SESSION_TTL_DAYS=30

# Plugins to load at startup: package names or paths (relative to the repo
# root), comma-separated.
# Each plugin gets CFLOW_PLUGIN_<NAME>_<KEY> as its options, where <NAME> is the
# last segment of its specifier without "cflow-plugin-".
CFLOW_PLUGINS=
