# One .env for the whole app, at the repo root: Bun loads it for `dev` and `start`.

# The one server's port: the API under /api and the web app, in development and in production.
PORT=3000

# Behind a reverse proxy, every connection is the proxy's: true counts the API's rate limits by the client IP the proxy
# adds to X-Forwarded-For. Only set it behind one, as clients can send that header themselves. The Docker image sets it.
TRUST_PROXY=false

# Requests a minute each client may make to the API (/api/health aside), 300 when empty; 0 turns the limit off.
RATE_LIMIT=300

# The largest request body the API reads, in bytes, 1 MB when empty. Anything else fails at start.
MAX_BODY_BYTES=1048576

# The database file, relative to where the server runs: server/ for dev, so this is data/cflow.db at the repo root, and
# server/dist/ for start. Without it, /data/cflow.db, the Docker image's volume.
DATABASE_PATH=../data/cflow.db

# Zone that defines "today" for transaction dates, and how long a login lasts.
APP_TIMEZONE=UTC
SESSION_TTL_DAYS=30

# Offer a read-only "Enter as guest" session on the login screen (true/1/yes).
ALLOW_GUEST=false

# Modules to enable, comma-separated. "core" is required (transactions, categories, balance, summary); "i18n" adds
# Spanish. Unset or empty means just "core".
CFLOW_PLUGINS=core,i18n
